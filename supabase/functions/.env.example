# Variables de las Edge Functions public-request (docs/contracts/public-request.md §4), chef
# (docs/contracts/chef-api.md §8: ALLOWED_ORIGINS y las de la traducción de los platos, al final) y
# client-link (docs/contracts/client-link.md §7: IP_HASH_SALT, ALLOWED_ORIGINS y las de los avisos a
# Evelyn, las mismas que public-request).
# Local: copiar a supabase/functions/.env (no se versiona); `npx supabase start` lo carga solo.
# Producción: secretos de las funciones (los comparten todas); los carga
# .github/workflows/deploy-supabase.yml desde los secretos y variables de GitHub. SUPABASE_URL y la
# clave secreta las pone Supabase: no van acá.

# --- Cocinera ----------------------------------------------------------------------------------
# Opcional: uuid de la cocinera en public.chefs (lo devuelve promote_to_chef). Si falta, la función
# usa la única fila de public.chefs; con ninguna o con más de una responde 500 (log
# chef_id_unresolved). Un valor que no es uuid también da 500 (log config_invalid).
# Local hace falta: el seed tiene dos cocineras (Evelyn y Giulia); esta es Evelyn.
CHEF_ID=cef00000-0000-4000-8000-000000000001

# --- Obligatorias (sin ellas la función responde 500) -----------------------------------------
# Cloudflare Turnstile. Locales: 1x0000000000000000000000000000000AA siempre aprueba y
# 2x0000000000000000000000000000000AA siempre rechaza (aceptan solo el token XXXX.DUMMY.TOKEN.XXXX).
# Nunca en producción: deploy-supabase.yml corta si llega una de prueba (y si las URLs de abajo
# apuntan a localhost).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Sal (clave HMAC) del hash de la IP. Aleatoria: openssl rand -hex 32. La IP nunca se guarda en claro.
IP_HASH_SALT=solo-para-desarrollo-local

# --- Emails ------------------------------------------------------------------------------------
# resend (por defecto) o log (desarrollo: no manda nada; registra solo metadatos, sin direcciones).
EMAIL_TRANSPORT=log
# Clave de Resend con permiso solo de envío ("Sending access"), restringida al dominio.
RESEND_API_KEY=
MAIL_FROM="Radici <ciao@radicicucina.app>"
# A dónde van las respuestas del cliente; si falta, CHEF_NOTIFY_EMAIL.
MAIL_REPLY_TO=
# Email de Evelyn para los avisos de pedido nuevo (sin él, no hay aviso por email).
CHEF_NOTIFY_EMAIL=evelyn@example.test
# Idioma de los avisos a Evelyn: es (por defecto), it o en.
CHEF_LOCALE=es

# --- Web y bandeja -----------------------------------------------------------------------------
# Orígenes permitidos (CORS), separados por comas. Producción: solo https://radicicucina.app.
# Las vistas previas de los PR (https://<rama>.<pages>.pages.dev) NO van: se construyen con el
# Supabase de producción y crearían pedidos reales (emails a Evelyn y al cliente). Para probar una
# a mano, sumar un rato su origen exacto (https://<rama>.<pages>.pages.dev; <pages> = subdominio
# que Cloudflare asigne al proyecto de Pages "radici") y sacarlo al terminar (contrato §4).
# Admite comodín de una etiqueta (https://*.<pages>.pages.dev), pero nunca https://*.pages.dev
# (sería cualquier sitio de Pages).
# La función chef (el área de Evelyn) usa la misma lista: cualquier origen de acá puede llamarla con
# la sesión de Evelyn o de un colaborador suyo (public.chef_id_for_user). Para probar /gestione/ en
# local con `flutter run -d web-server --web-port 8080`, sumar http://localhost:8080 (desde el
# teléfono, http://<IP de la PC>:8080).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bandeja de la app web: el email a Evelyn abre INBOX_URL#/richieste/<id>.
INBOX_URL=http://localhost:5173/gestione/
# Web pública: link a la privacy en la confirmación al cliente.
PUBLIC_SITE_URL=http://localhost:5173

# --- WhatsApp Cloud API (opcional: sin las tres no se manda WhatsApp) ---------------------------
# Token de un usuario de sistema con whatsapp_business_messaging (secreto).
WHATSAPP_TOKEN=
# Id numérico del número de WhatsApp Business (no es el teléfono).
WHATSAPP_PHONE_NUMBER_ID=
# Plantilla aprobada (categoría utility) en it, es y en, con el parámetro {{first_name}}.
WHATSAPP_TEMPLATE=

# --- Traducción de los platos (función chef, POST /chef/translate; contrato chef-api.md §12) -----
# fake (desarrollo): una traducción de mentira reconocible ("[it] <nombre>", "[en] <nombre>") sin
# llamar a Claude ni gastar, para probar la app. Vacío o cualquier otro valor: Claude, si hay clave.
# Solo vale con un Supabase local (SUPABASE_URL en kong, localhost o 127.0.0.1): en cualquier otro
# lado la función lo ignora (log translate_fake_ignored) y la traducción queda apagada. Nunca en
# producción: deploy-supabase.yml no la carga y corta si la encuentra en los secretos de Supabase.
TRANSLATE_TRANSPORT=fake
# Clave de la API de Claude (Anthropic). Sin ella, y sin fake, POST /chef/translate responde 501 y
# el arranque avisa (config_incomplete). En producción la carga deploy-supabase.yml desde el secreto
# ANTHROPIC_API_KEY de GitHub. A Anthropic solo van el nombre y la descripción del plato.
ANTHROPIC_API_KEY=
