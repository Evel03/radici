# Variables de la Edge Function public-request (docs/contracts/public-request.md §4).
# Local: copiar a supabase/functions/.env (no se versiona); `npx supabase start` lo carga solo.
# Producción: secretos de la función; los carga .github/workflows/deploy-supabase.yml desde los
# secretos y variables de GitHub. SUPABASE_URL y la clave secreta las pone Supabase: no van acá.

# --- Obligatorias (sin ellas la función responde 500) -----------------------------------------
# uuid de la cocinera en chefs. Local: Evelyn del seed. Producción: lo devuelve promote_to_chef.
CHEF_ID=cef00000-0000-4000-8000-000000000001
# Cloudflare Turnstile. Locales: 1x0000000000000000000000000000000AA siempre aprueba y
# 2x0000000000000000000000000000000AA siempre rechaza (aceptan solo el token XXXX.DUMMY.TOKEN.XXXX).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Sal (clave HMAC) del hash de la IP. Aleatoria: openssl rand -hex 32. La IP nunca se guarda en claro.
IP_HASH_SALT=solo-para-desarrollo-local

# --- Emails ------------------------------------------------------------------------------------
# resend (por defecto) o log (desarrollo: no manda nada; registra solo metadatos, sin direcciones).
EMAIL_TRANSPORT=log
# Clave de Resend con permiso solo de envío ("Sending access"), restringida al dominio.
RESEND_API_KEY=
MAIL_FROM="Mestolo <ciao@mestolo.sepusola10.com>"
# A dónde van las respuestas del cliente; si falta, CHEF_NOTIFY_EMAIL.
MAIL_REPLY_TO=
# Email de Evelyn para los avisos de pedido nuevo (sin él, no hay aviso por email).
CHEF_NOTIFY_EMAIL=evelyn@example.test
# Idioma de los avisos a Evelyn: it (por defecto), es o en.
CHEF_LOCALE=es

# --- Web y bandeja -----------------------------------------------------------------------------
# Orígenes permitidos (CORS), separados por comas. Admite comodín de una etiqueta:
# https://*.mestolo-dsa.pages.dev. Nunca https://*.pages.dev (sería cualquier sitio de Pages).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bandeja de la app web: el email a Evelyn abre INBOX_URL#/richieste/<id>.
INBOX_URL=http://localhost:5173/gestione/
# Web pública: link a la privacy en la confirmación al cliente.
PUBLIC_SITE_URL=http://localhost:5173

# --- WhatsApp Cloud API (opcional: sin las tres no se manda WhatsApp) ---------------------------
# Token de un usuario de sistema con whatsapp_business_messaging (secreto).
WHATSAPP_TOKEN=
# Id numérico del número de WhatsApp Business (no es el teléfono).
WHATSAPP_PHONE_NUMBER_ID=
# Plantilla aprobada (categoría utility) en it, es y en, con el parámetro {{first_name}}.
WHATSAPP_TEMPLATE=
