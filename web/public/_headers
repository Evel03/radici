# Cabeceras de Cloudflare Pages. Se copian a dist/ y el build completa los marcadores del origen de
# Supabase (https y wss, ver SUPABASE_*_TOKEN en src/build/headers.ts) con VITE_SUPABASE_URL; sin esa
# variable los quita. `npm run preview` las aplica igual que Pages.
#
# Cómo se combinan: cada pedido toma las cabeceras de TODAS las reglas que coinciden, en el orden del
# archivo. Si dos reglas ponen la misma cabecera, los valores se unen con una coma (dos CSP: el navegador
# aplica las dos). Para cambiar la CSP de una ruta, en una regla que vaya DESPUÉS de /*:
#   ! Content-Security-Policy         (quita la de /*)
#   Content-Security-Policy: ...      (la nueva)
# Límites: 100 reglas y 2000 caracteres por línea.
#
# CSP estricta en las páginas públicas: todo el JS y el CSS son archivos propios. El único <script>
# inline es el JSON-LD de la landing, que es un bloque de datos y la CSP no lo bloquea.
# /gestione/ (la app Flutter) tiene su propia CSP, más abajo.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Formulario de pedido: Cloudflare Turnstile (script e iframe), la Edge Function public-request y las fotos
# de los platos de la pestaña «Menù» (bucket público recipe-photos, en el mismo origen de Supabase).
/richiesta/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: __SUPABASE_ORIGIN__; font-src 'self'; connect-src 'self' __SUPABASE_ORIGIN__; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Página de la clienta (SPEC 5.8): su reserva con el menú de cada semana. La Edge Function client-link y las
# fotos de los platos (bucket público recipe-photos, en el mismo origen de Supabase); sin Turnstile ni nada de
# terceros. Se abre con un link personal (el token va en el fragmento, que no llega a ningún servidor): nunca
# se indexa.
/prenotazione/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: __SUPABASE_ORIGIN__; font-src 'self'; connect-src 'self' __SUPABASE_ORIGIN__; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow

# Captcha de Auth: la verificación anti-spam del acceso a la app (Turnstile con la sitekey de Auth). La abre la
# app de Evelyn en un iframe del mismo sitio (/gestione/ y /app/) o en una WebView; no es una página
# para visitar. Solo lo que Turnstile necesita (script e iframe de challenges.cloudflare.com); sin Supabase, sin
# fotos. Es la única página que se deja enmarcar, y solo por el propio sitio: frame-ancestors 'self' y
# X-Frame-Options SAMEORIGIN (el DENY de /* se quita acá: sin eso el navegador no la mostraría en el marco).
/captcha/*
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Robots-Tag: noindex, nofollow

# Confirmar el alta o elegir una contraseña nueva desde el link de un email de Auth (docs/contracts/auth.md §11). El
# link (token_hash) va en el fragmento y la página lo canjea por una sesión que vive solo en memoria:
# - connect-src: solo Supabase (Auth). Nada de terceros: el captcha de «Reinvia» corre dentro de /captcha/ (frame-src
#   'self'), nunca acá.
# - form-action 'none': si el código no corre, un formulario nunca manda la contraseña ni el email a ningún lado.
# - Referrer-Policy no-referrer (la página no manda su dirección a nadie), Cache-Control no-store (ni el navegador ni
#   un proxy guardan la página; tampoco queda en la caché de «atrás») y nunca se indexa.
/accesso/*
  ! Content-Security-Policy
  ! Referrer-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' __SUPABASE_ORIGIN__; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Ofertas y novedades: confirmar o darse de baja desde el link del email (docs/contracts/public-request.md §13). El
# token va en el fragmento y la página lo manda en el cuerpo de un POST a public-request:
# - connect-src: solo Supabase (la función). Nada de terceros, ni fotos, ni marcos.
# - form-action 'none': la página no tiene formularios; si alguno apareciera, no manda nada a ningún lado.
# - Referrer-Policy no-referrer, Cache-Control no-store y nunca se indexa (como /accesso/).
/preferenze/*
  ! Content-Security-Policy
  ! Referrer-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' __SUPABASE_ORIGIN__; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Bandeja y agenda de Evelyn: la app Flutter web (build en dist/gestione/, ver app/README.md "Web
# /gestione/"). Todo se sirve desde el mismo origen; la CSP de /* no le alcanza:
# - script-src 'wasm-unsafe-eval': CanvasKit es WebAssembly (sin él la app no arranca). Nada de
#   'unsafe-inline' ni 'unsafe-eval' en scripts (el build usa --csp).
# - style-src 'unsafe-inline': el motor inserta <style> que cambian según el navegador (no sirven hashes).
# - img-src blob: en Safari y Firefox (sin ImageDecoder) el motor decodifica cada imagen en un <img> con
#   una URL blob: (las fotos de los platos y la vista previa de la elegida), e image_picker carga ahí la
#   foto elegida para achicarla. El origen de Supabase (bucket recipe-photos), por si una imagen se carga
#   con un <img>: hoy el motor las pide con XMLHttpRequest (connect-src).
# - frame-src 'self': el marco del captcha de Auth (/captcha/, mismo origen: lo abre CaptchaService para pedir el
#   token del login). Nada de terceros: Turnstile corre dentro de /captcha/, no acá.
# - connect-src: Supabase por https (Auth, REST, Storage) y wss (Realtime, el aviso de pedido nuevo), y
#   blob: (la foto elegida se lee de su URL blob: con XMLHttpRequest).
# Caché: los archivos de Flutter NO llevan hash en el nombre (main.dart.js, canvaskit/…): cada carga
# revalida (ETag → 304 si no cambió). La regla de /assets/* no alcanza a /gestione/assets/*.
/gestione/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: __SUPABASE_ORIGIN__; connect-src 'self' blob: __SUPABASE_ORIGIN__ __SUPABASE_WS_ORIGIN__; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow

# Área de la clienta: la misma app Flutter web, publicada en dist/app/ (PR13; el mismo build que /gestione/ con otra
# entrada, ver .github/scripts/publish-app-entries.sh). Mismas reglas que /gestione/ (CSP, sin caché larga,
# noindex), en una regla propia porque Pages no admite una lista de rutas: si cambia una, cambia la otra
# (headers.test.ts compara las dos). frame-src 'self' es el marco del captcha de Auth (/captcha/, mismo origen).
# Hasta PR69 ningún link público lleva a /app/ (web/src/build/no-app-links.test.ts).
/app/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: __SUPABASE_ORIGIN__; connect-src 'self' blob: __SUPABASE_ORIGIN__ __SUPABASE_WS_ORIGIN__; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow

# Los archivos de assets/ llevan hash en el nombre: se pueden cachear para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Las copias en *.pages.dev nunca se indexan: la de producción (<proyecto>.pages.dev) y las vistas previas
# (<rama o hash>.<proyecto>.pages.dev). El dominio propio no cambia: ahí manda VITE_NOINDEX. Ejemplo de las
# docs de Pages ("Headers", act. 25/08/2026): en el host un marcador no cruza puntos, por eso son dos reglas.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
