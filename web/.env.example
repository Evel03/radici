# Copiar a web/.env.local (no se versiona) y completar. Vite solo expone variables VITE_*.
# Se interpretan en un solo lugar: web/src/config.ts. Al JS del sitio llegan solo las que lee el navegador
# (VITE_BRAND_NAME, VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY, VITE_TURNSTILE_SITE_KEY y VITE_TURNSTILE_AUTH_SITE_KEY,
# en web/src/site-config.ts); las demás las usa el build (HTML, CSP, robots.txt). Ninguna es secreta.

# Proyecto de Supabase (Settings → API): URL sin barra final. En local, la de `npx supabase start`:
# http://127.0.0.1:54321. El formulario manda el pedido a <URL>/functions/v1/public-request (con
# ?forceFunctionRegion=eu-central-1: la función corre en Frankfurt) y el build pone ese origen en la CSP
# de /richiesta/ (connect-src). Sin ella, el formulario no puede enviar.
VITE_SUPABASE_URL=

# Clave publicable de Supabase (sb_publishable_...; en local, la de `npx supabase status`). La usa /accesso/
# (apikey de sus llamadas a Supabase Auth). El build solo la acepta si es publicable (o la anon vieja): una
# secreta o la service_role quedan fuera del JS. public-request y client-link no la necesitan.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sitekey de Cloudflare Turnstile (widget en modo Managed). En local, la de prueba que siempre aprueba
# (con la secreta de prueba 1x0000000000000000000000000000000AA en la Edge Function).
# En producción, la sitekey real del widget, con el dominio del sitio en su lista de hostnames.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Sitekey de Turnstile de Auth (/captcha/: el captcha de los pedidos a Supabase Auth). Es OTRO widget que el
# del formulario (con su propia sitekey y su secreta, que va en Supabase Auth, nunca en el repo). Modo
# Managed, con el dominio del sitio en su lista de hostnames. En local, la misma de prueba.
VITE_TURNSTILE_AUTH_SITE_KEY=1x00000000000000000000AA

# Nombre de la marca. Si falta, se usa Radici.
VITE_BRAND_NAME=Radici

# true mientras la web esté en el subdominio de prueba: <meta name="robots" content="noindex"> en todas las páginas.
VITE_NOINDEX=true

# URL pública sin barra final (ej. https://radicicucina.app).
# Se usa para canonical, og:url, og:image (la imagen de los links compartidos tiene que ir con URL
# absoluta), JSON-LD, robots.txt y sitemap.xml. Sin ella el build avisa: no hay imagen al compartir ni sitemap.xml.
VITE_SITE_URL=
