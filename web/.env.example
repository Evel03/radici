# Copiar a web/.env.local (no se versiona) y completar. Vite solo expone variables VITE_*.
# Todas se leen en un solo lugar: web/src/config.ts.

# Número de WhatsApp de Evelyn: formato internacional, solo dígitos y sin "+".
# Ej. un móvil italiano 333 123 4567 → 393331234567. Si falta, el formulario muestra un error.
VITE_WHATSAPP_NUMBER=

# Nombre de la marca (provisorio).
VITE_BRAND_NAME=Mestolo

# true mientras la web esté en el subdominio de prueba: <meta name="robots" content="noindex"> en todas las páginas.
VITE_NOINDEX=true

# Opcional. URL pública sin barra final (ej. https://mestolo.ejemplo.com).
# Se usa para canonical, og:url, JSON-LD, robots.txt y sitemap.xml (sin ella, sitemap.xml no se publica).
VITE_SITE_URL=
